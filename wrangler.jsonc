{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wishing-portal",
  "main": "worker.js",
  "compatibility_date": "2026-08-17",
  "routes": [
    { "pattern": "thegreeter.in/*", "zone_name": "thegreeter.in" },
    { "pattern": "www.thegreeter.in/*", "zone_name": "thegreeter.in" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wishing-portal-db",
      "database_id": "6f99ef52-d801-425a-9c3e-293776aa7ea3"
    }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public"
  }
}
